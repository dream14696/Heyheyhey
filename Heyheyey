        local success, response = pcall(function()
            return httpRequest({
                Url = getApiUrl(),
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. keyText
                },
                Body = HttpService:JSONEncode({
                    model = MODEL_NAME,
                    messages = { { role = "user", content = "ping" } },
                    max_tokens = 5
                })
            })
        end)
        
        if elapsed < 8 then
            task.wait(8 - elapsed)
        end
        if rotConn.Connected then
            rotConn:Disconnect()
        end
        
        loaderContainer.Visible = false
        continueBtn.Visible = true
        
        local isValid = false
        if success and response and response.Body then
            local decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if decoded then
                local data = HttpService:JSONDecode(response.Body)
                if data.choices or (data.error == nil) then
                    isValid = true
                end
            end
        end
        
        if isValid then
            savedApiKey = keyText
            authFrame.Visible = false
            mainFrame.Visible = true
            addMessage("Sistema", "ChatGPT inicializado correctamente.", false)
        else
            showErrorNotification("API Key inválida o sin fondos. Inténtalo de nuevo.")
        end
    end)
end)

local function enviarAChatGPT(mensajeTexto)
    if mensajeTexto == "" then return end
    
    addMessage("Tú", mensajeTexto, false)
    messageBox.Text = ""
    
    task.spawn(function()
        if not httpRequest then
            addMessage("Sistema", "Error: Tu ejecutor no soporta funciones HTTP.", true)
            return
        end
        
        local successReq, response = pcall(function()
            return httpRequest({
                Url = getApiUrl(),
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. savedApiKey
                },
                Body = HttpService:JSONEncode({
                    model = MODEL_NAME,
                    messages = {
                        { role = "system", content = "Eres un asistente experto en Roblox Luau. Responde directamente de forma técnica y con bloques de código markdown." },
                        { role = "user", content = mensajeTexto }
                    }
                })
            })
        end)
        
        if successReq and response and response.Body then
            local decodeSuccess, decodedResponse = pcall(function()
                return HttpService:JSONDecode(response.Body)
            end)
            
            if decodeSuccess and decodedResponse.choices and decodedResponse.choices[1] then
                local respuestaGPT = decodedResponse.choices[1].message.content
                addMessage("ChatGPT", respuestaGPT, false)
            elseif decodedResponse and decodedResponse.error then
                local errMsg = tostring(decodedResponse.error.message)
                addMessage("Sistema", "Error API: " .. errMsg, true)
                if string.find(errMsg, "quota") or string.find(errMsg, "invalid") or string.find(errMsg, "Key") or string.find(errMsg, "Billing") then
                    mainFrame.Visible = false
                    authFrame.Visible = true
                    showErrorNotification("La API Key falló o no tiene créditos. Regístrala nuevamente.")
                end
            else
                addMessage("Sistema", "Respuesta no válida de ChatGPT.", true)
            end
        else
            addMessage("Sistema", "Fallo al conectar con OpenAI.", true)
        end
    end)
end

sendButton.MouseButton1Click:Connect(function() enviarAChatGPT(messageBox.Text) end)
messageBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then enviarAChatGPT(messageBox.Text) end
end)
