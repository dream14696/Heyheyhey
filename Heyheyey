        copyBtn.TextSize = 10
        copyBtn.Font = Enum.Font.GothamBold
        copyBtn.Parent = msgContainer
        Instance.new("UICorner", copyBtn).CornerRadius = UDim.new(0, 4)
        
        codeFrame.Position = UDim2.new(0, 4, 0, 18)
        
        copyBtn.MouseButton1Click:Connect(function()
            if Clipboard then
                pcall(function() Clipboard(rawCode) end)
                copyBtn.Text = "¡Copiado!"
                task.wait(1.5)
                copyBtn.Text = "📋 Copiar script"
            else
                copyBtn.Text = "No compatible"
            end
        end)
    end
    
    if isMinimized and sender ~= "Tú" then
