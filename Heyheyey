local function addMessage(sender, text, isError)
    local msgContainer = Instance.new("Frame")
    msgContainer.Size = UDim2.new(1, 0, 0, 0)
    msgContainer.AutomaticSize = Enum.AutomaticSize.Y
    msgContainer.BackgroundTransparency = 1
    msgContainer.Parent = chatScroll
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -8, 0, 0)
    msgLabel.Position = UDim2.new(0, 4, 0, 0)
    msgLabel.AutomaticSize = Enum.AutomaticSize.Y
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = "<b>" .. sender .. ":</b> " .. text
    msgLabel.RichText = true
    msgLabel.TextColor3 = isError and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(230, 230, 240)
    msgLabel.TextSize = 12
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.Parent = msgContainer
    
    if string.find(text, "```") then
        local startIdx, endIdx = string.find(text, "```.-```")
        local rawCode = text
        if startIdx then
            rawCode = string.sub(text, startIdx + 3, endIdx - 3)
            rawCode = string.gsub(rawCode, "^%a+\n", "")
        end
        
        msgLabel.Visible = false
        
        local codeFrame = Instance.new("Frame")
        codeFrame.Size = UDim2.new(1, -8, 0, 0)
